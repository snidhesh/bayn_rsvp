# --- BlackOak internal CRM (studio.blackoak-re.com lead intake) ---
BLACKOAK_CRM_URL=
BLACKOAK_CRM_TOKEN=

# --- Resend (branded confirmation email sent after form submit) ---
# Domain in RESEND_FROM must be verified in Resend before sends will deliver.
RESEND_API_KEY=
RESEND_FROM="Bayn <invitation@blackoak-re.com>"

# --- Public: base path prefix so this app can be served under a parent domain
#     sub-path (e.g. blackoak-re.com/baynopenhouse). Set to "/baynopenhouse"
#     in Vercel production/preview. Leave blank locally for dev at root.
NEXT_PUBLIC_BASE_PATH=
