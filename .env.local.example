# --- BlackOak internal CRM (studio.blackoak-re.com lead intake) ---
BLACKOAK_CRM_URL=
BLACKOAK_CRM_TOKEN=

# --- Resend transactional email ---
RESEND_API_KEY=
RESEND_FROM="Bayn Open Day <openday@blackoak-re.com>"

# --- Optional: reply-to / BCC for internal ops ---
RSVP_BCC=

# --- Public: numeric Vimeo video ID for the "Open House - Dana" clip ---
NEXT_PUBLIC_DANA_VIMEO_ID=

# --- Public: base path prefix so this app can be served under a parent domain
#     sub-path (e.g. blackoak-re.com/baynopenhouse). Set to "/baynopenhouse"
#     in Vercel production/preview. Leave blank locally for dev at root.
NEXT_PUBLIC_BASE_PATH=
